# Copy to .env (optional). All values have safe defaults.

# Port for the LAN room server (WebSocket at /ws, health at /health, and in
# production also the static web build).
PE_PORT=3001

# Interface to bind. 0.0.0.0 exposes the server to your local network (needed
# for phones on the same Wi-Fi/hotspot). Use 127.0.0.1 to keep it on this PC.
PE_HOST=0.0.0.0

# Extra allowed browser origins for WebSocket connections (comma separated).
# Loopback, private LAN addresses and the server's own host are always allowed.
# Example for a reverse proxy: https://game.example.lan
PE_ALLOWED_ORIGINS=

# Where the host keeps canonical LAN match saves.
PE_SAVE_DIR=apps/server/data/saves

# Delay (ms) before a bot acts on the server, so clients can follow animations.
PE_BOT_DELAY_MS=700

# Port for the Vite dev server (development only).
PE_WEB_PORT=5173
